# Environments
.venv/

# Editors / IDEs
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# MLflow local tracking store (SQLite backend + run artifacts; regenerated by
# training). mlruns/ is the legacy file store, kept ignored for older checkouts.
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/

# Secrets / environment
.env
.env.*

# Coverage
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Junie session plans - scratch notes for an agent session, not project docs
# (durable documentation lives in docs/).
.junie/

# Stray extensionless scratch file at the repo root.
/learning

# HuggingFace Trainer checkpoints: regenerated by training/train_transformer.py
# and gigabytes in size, so they never belong in git.
model_store/*_checkpoints/

# Logs
*.log
