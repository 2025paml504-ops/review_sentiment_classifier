# Environments
.venv/

# Editors / IDEs
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# MLflow local tracking store (SQLite backend + run artifacts; regenerated by
# training). mlruns/ is the legacy file store, kept ignored for older checkouts.
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/

# Secrets / environment
.env
.env.*

# Coverage
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db


# HuggingFace Trainer checkpoints: regenerated by training/train_transformer.py
# and gigabytes in size, so they never belong in git.
model_store/*_checkpoints/

# Stray/non-canonical training output dir - transformer checkpoints land here
# when train_transformer runs from training/ (~113 GB). Canonical model outputs
# live in the root model_store/ (ignored above). Never belongs in git.
/training/model_store/

# Generated experiment outputs, regenerated by training runs:
#   artifacts/  - per-run confusion matrices + classification reports
#   metrics/    - scratch metrics dumps (tracked metrics are training/metrics_*.json)
/artifacts/
/metrics/

# Logs
*.log
